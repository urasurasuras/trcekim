# Development: branch dev, https://dev-trcekim.uras.app -> 192.168.0.2:8091.
# Copy to /docker/docker-compose/trcekim/trcekim-dev.env (mode 600).
CONTAINER_NAME=trcekim-dev
HOST_PORT=8091
DATA_DIR=/srv/dev-disk-by-uuid-03d52f78-cc5f-4477-b6b3-1cbf9daac6e0/appdata/trcekim-dev

# The admin user is created on first start only; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail goes to the shared Mailpit container (http://192.168.0.2:8025).
SMTP_FROM=noreply@dev-trcekim.uras.app
SMTP_NOTIFY_TO=trcekim@dev-trcekim.uras.app
