# Production: branch main, https://trcekim.uras.app -> 192.168.0.2:8090.
# Copy to /docker/docker-compose/trcekim/trcekim.env (mode 600).
CONTAINER_NAME=trcekim
HOST_PORT=8090
DATA_DIR=/srv/dev-disk-by-uuid-03d52f78-cc5f-4477-b6b3-1cbf9daac6e0/appdata/trcekim

# The admin user is created on first start only; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail goes to the shared Mailpit container (http://192.168.0.2:8025) until a real
# SMTP provider is chosen. Then set SMTP_HOST, SMTP_PORT, SMTP_ENABLE_SSL, SMTP_USER
# and SMTP_PASSWORD here.
SMTP_FROM=noreply@trcekim.uras.app
SMTP_NOTIFY_TO=trcekim@trcekim.uras.app
