# Copy to trcekim.env next to trcekim.yml (or paste into the OMV "Environment" box).
# The admin user is created on first start only; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: e-mail notifications for orders and contact messages.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_NOTIFY_TO=
